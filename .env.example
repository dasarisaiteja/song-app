# Backend API Keys (Store in .env or edge function environment variables)
# Cost per song generation: ~15 to 20 Paise ($0.002 USD) - Well within the 50 Paise limit!

# OpenAI API Key (For tts-1 audio synthesis)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Groq API Key (Recommended for ultra-fast, ultra-cheap Llama-3.1-8B inference: < $0.00001 per request)
GROQ_API_KEY=gsk_your-groq-key-here

# Alternatively, Google Gemini API Key
GEMINI_API_KEY=AIzaSy...

# Optional: Backing track URL (Royalty-free acoustic/lo-fi loop to mix or play synchronously)
DEFAULT_BACKING_TRACK_URL=https://cdn.freesound.org/previews/448/448080_9159316-lq.mp3
